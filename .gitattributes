# Normalize line endings: LF in the repo, native on checkout
* text=auto

*.py    text eol=lf
*.ino   text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf

# Binary / hands-off
*.png       binary
*.pdf       binary
*.step      binary
*.stp       binary
*.pt        binary
*.ipynb     -text
*.kicad_pcb -text
*.kicad_sch -text
*.kicad_pro -text
